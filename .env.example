# ─── Core ────────────────────────────────────────────────────────────────────
PAYLOAD_SECRET=replace-with-a-long-random-string

# ─── Server ──────────────────────────────────────────────────────────────────
# URL this backend is reachable at (used by Payload for media URLs, CORS, etc.)
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3001

# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# ─── Database ────────────────────────────────────────────────────────────────
# Development (SQLite — default, no extra config needed)
# DATABASE_URI=file:./animal-sos.db

# Production (PostgreSQL — uncomment and fill in when deploying)
# DATABASE_URI=postgresql://user:password@host:5432/animal_sos

# ─── Email (Nodemailer + free SMTP) ──────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address@gmail.com
# Use a Gmail App Password (not your account password)
# https://myaccount.google.com/apppasswords
SMTP_PASS=your-app-password-here

FROM_EMAIL=adoptions@animalsosadoptions.com
FROM_NAME=Animal SOS Adoptions

# Admin notification recipient
ADMIN_EMAIL=admin@animalsosadoptions.com
